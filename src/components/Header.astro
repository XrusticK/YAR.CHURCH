---
import { url, stripBase } from '../lib/url';
import { NAV } from '../data/site';
const path = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="logo" href={url("/")} aria-label="Ярославская церковь — главная">
      <img src={url("/img/logo-mark-black.png")} alt="" width="66" height="42">
      <span class="logo__text">Ярославская<br>церковь</span>
    </a>
    <nav class="nav" id="nav" aria-label="Основное меню">
      {NAV.map((n, i) => (
        <a href={url(n.href)} style={`--i:${i}`} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
      <a class="btn nav__donate" href={url("/donate")} style={`--i:${NAV.length}`}>Пожертвовать</a>
    </nav>
    <a class="btn btn--outline header-donate" href={url("/donate")}>Пожертвовать</a>
    <button class="burger" type="button" aria-expanded="false" aria-controls="nav" aria-label="Меню"><span></span><span></span><span></span></button>
  </div>
</header>
