---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../data/site';
const arrow = '<svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---
<Base title="О церкви" description="Ярославская община Церкви христиан адвентистов седьмого дня: кто мы, дом молитвы на Большой Фёдоровской, 111 и пастор общины.">
  <PageHero title="О церкви" lead="Мы рады, что вы хотите узнать о нас больше." image="/img/church.jpg" imagePosition="50% 30%" />

  <div class="sheet">
    <section class="section">
      <div class="container split split--media-first">
        <div class="split__media" data-reveal><img src={url("/img/church.jpg")} alt="Дом молитвы на Большой Фёдоровской, 111" loading="lazy"></div>
        <div class="split__text" data-reveal style="--d:150ms">
          <span class="eyebrow">С 1999 года</span>
          <h2 class="h2">Община на Большой Фёдоровской</h2>
          <p>Ярославская церковь — община Церкви христиан адвентистов седьмого дня, протестантской церкви, которая есть более чем в 200 странах мира. В Ярославле община официально зарегистрирована с 1999 года и собирается в своём доме молитвы на улице Большая Фёдоровская, 111.</p>
          <p>Мы — разные люди: семьи с детьми, студенты, люди старшего поколения. Каждую субботу мы вместе изучаем Библию, молимся, поём и слушаем проповедь, а после — общаемся, проводим встречи для детей и молодёжи.</p>
          <div class="actions"><a class="btn btn--fill" href={url("/welcome")}>Впервые у нас <Fragment set:html={arrow} /></a><a class="btn btn--outline" href={url("/schedule")}>Расписание</a></div>
        </div>
      </div>
    </section>

    <section class="section section--soft" id="pastor">
      <div class="container split">
        <div class="split__text" data-reveal>
          <span class="eyebrow">Пастор общины</span>
          <h2 class="h2">{SITE.pastor}</h2>
          <!-- Сюда лучше поставить приветствие или пару слов о себе от самого пастора -->
          <p class="pastor__text">Пастор будет рад познакомиться с вами лично: ответить на вопросы о вере и Библии, поддержать в трудную минуту, помолиться вместе. Подойдите после богослужения или напишите заранее.</p>
          <a class="btn btn--fill" href={SITE.pastorTelegram}>Написать в Telegram <Fragment set:html={arrow} /></a>
        </div>
        <div class="pastor__media" data-reveal style="--d:150ms"><img src={url("/img/pastor.jpg")} alt={`Пастор ${SITE.pastor} с Библией`} loading="lazy"></div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head" data-reveal><div><span class="eyebrow">Каждую неделю</span><h2 class="h2">Жизнь общины</h2></div></div>
        <div class="cards cards--4">
          <div class="card" data-reveal><h3 class="h3">Богослужения</h3><p>По субботам с 10:00: субботняя школа, Школа Библии, в 12:00 — проповедь.</p></div>
          <div class="card" data-reveal style="--d:80ms"><h3 class="h3">Дети и подростки</h3><p>Клубы «Следопыт» и «Искатели приключений» — по субботам в 15:00.</p></div>
          <div class="card" data-reveal style="--d:160ms"><h3 class="h3">Молодёжь</h3><p>Молодёжное служение по субботам в 17:00, поездки и программы.</p></div>
          <div class="card" data-reveal style="--d:240ms"><h3 class="h3">Встречи</h3><p>Женский клуб, «Золотое время» для старшего поколения, хор.</p></div>
        </div>
      </div>
    </section>
  </div>
</Base>
