# Сайт Ярославской церкви — статические файлы (Apache на виртуальном хостинге)
Options -Indexes
DirectoryIndex index.html
DirectorySlash On
ErrorDocument 404 /404.html

# Принудительный HTTPS — включите, когда в панели хостинга выпущен SSL-сертификат
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  # CSS и JS лежат в /_astro/ с хешем в имени — их можно кешировать надолго
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
</IfModule>
